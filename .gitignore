##############################################################################
# Keil MDK / uVision：构建产物与本地状态
##############################################################################

# 整个编译输出目录：
#   *.o *.crf *.d *.dep *.axf *.hex *.map *.htm *.lnp *.sct ...
# 每次 Build 都会重新生成，不进版本库
MDK-ARM/F103/

# uVision 生成的构建日志
MDK-ARM/*.build_log.htm

# 汇编列表（Assembler Listing）
MDK-ARM/*.lst

# 每个用户的窗口布局 / 断点 / 观察窗口等本地状态
MDK-ARM/*.uvguix.*

# 如果连调试器配置也不想入库，取消下面这行的注释；
# 团队要共享 ST-Link 下载算法和调试配置时保持注释状态
# MDK-ARM/*.uvoptx

##############################################################################
# 通用构建产物（防止换输出目录 / 换工具链后再次误提交）
##############################################################################

*.o
*.crf
*.dep
*.lnp
*.sct
*.axf
*.hex
*.elf
*.bin
*.map
*.iex
*.build_log.htm
*.uvguix.*

##############################################################################
# 编译 / 调试过程的临时文件
##############################################################################

*.bak
*.tmp
*.log
JLinkLog.txt
